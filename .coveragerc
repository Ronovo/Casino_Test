[run]
branch = True
source =
    casino
    main

[report]
fail_under = 100
show_missing = True
skip_covered = True
exclude_also =
    if __name__ == .__main__.:

[html]
directory = coverage/python
title = Python server coverage
extra_css = coverage-index/coverage-py.css
skip_covered = False
skip_empty = True
